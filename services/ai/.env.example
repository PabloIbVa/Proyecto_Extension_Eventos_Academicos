# Puerto en el que corre este servicio
PORT=8000

# Proveedor de IA activo: "gemini" (recomendado, gratis) u "openrouter"
# (respaldo). Cambiar esto y reiniciar el servicio es todo lo que se
# necesita para pasar de uno a otro.
AI_PROVIDER=gemini

# --- Gemini (proveedor principal) ---
# Consíguela gratis en https://aistudio.google.com/apikey (no pide tarjeta)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- OpenRouter (respaldo, se usa solo si AI_PROVIDER=openrouter) ---
# Consíguela en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Revisa modelos gratuitos vigentes en https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
