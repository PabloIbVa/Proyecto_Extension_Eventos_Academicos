# Puerto en el que corre el BFF
PORT=3000

# Orígenes adicionales permitidos por CORS, separados por coma.
# El origen "chrome-extension://<id>" ya se permite automáticamente,
# así que normalmente esto se deja vacío en desarrollo.
FRONTEND_ORIGINS=

# URL del Google Calendar Service (NestJS)
CALENDAR_SERVICE_URL=http://localhost:3001

# URL del AI Processing Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
