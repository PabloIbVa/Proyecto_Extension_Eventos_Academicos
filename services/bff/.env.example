# Puerto en el que corre el BFF
PORT=3000

# Orígenes adicionales permitidos por CORS, separados por coma.
# El origen "chrome-extension://<id>" ya se permite automáticamente,
# así que normalmente esto se deja vacío en desarrollo.
FRONTEND_ORIGINS=

# URL del Google Calendar Service (NestJS) para llamadas internas
# servidor-a-servidor. Dentro de Docker Compose es el nombre del
# servicio, ej. http://calendar-service:3001
CALENDAR_SERVICE_URL=http://localhost:3001

# URL del Calendar Service alcanzable por el NAVEGADOR del usuario (se usa
# solo para la redirección de login). Casi siempre es localhost, incluso
# corriendo con Docker Compose, porque el navegador vive fuera de los
# contenedores. Si se omite, se usa CALENDAR_SERVICE_URL.
CALENDAR_SERVICE_PUBLIC_URL=http://localhost:3001

# URL del AI Processing Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
