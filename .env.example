# Este .env va en la RAÍZ del proyecto, junto a docker-compose.yml
# (al mismo nivel que las carpetas extension/ y services/).
# Docker Compose lo lee automáticamente al hacer `docker compose up`.

# --- Google Cloud Console (Paso 1 del proyecto) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI Service ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Respaldo, solo si cambias AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
